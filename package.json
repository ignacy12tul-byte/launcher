{
  "name": "minverse-launcher",
  "version": "1.0.0",
  "description": "minverse.pl — Minecraft Java launcher for Windows",
  "author": "minverse.pl",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:win": "electron-builder --win portable --x64",
    "build:installer": "node scripts/build-installer.js",
    "build:standalone": "node scripts/build-installer.js --embedded",
    "release:hash": "node scripts/hash.js"
  },
  "dependencies": {
    "minecraft-launcher-core": "3.18.2",
    "prismarine-auth": "3.1.1"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.65.0"
  },
  "overrides": {
    "request": "npm:@cypress/request@4.0.1",
    "adm-zip": "0.6.1",
    "uuid": "11.1.1"
  },
  "build": {
    "compression": "normal",
    "electronLanguages": ["pl", "en-US"],
    "appId": "pl.minverse.launcher",
    "productName": "minverse.pl",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "executableName": "Launcher"
    },
    "portable": {
      "artifactName": "Launcher.exe"
    }
  }
}
